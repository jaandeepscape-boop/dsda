        self._label(c, "Caption style preset").pack(fill="x", padx=14, pady=(4, 0))
        self.cap_style = ctk.CTkOptionMenu(
            c, values=list(CAPTION_STYLES.keys()))
        self.cap_style.set("Viral Yellow (MrBeast)")
        self.cap_style.pack(fill="x", padx=14, pady=(2, 6))

        r1 = ctk.CTkFrame(c, fg_color="transparent")
        r1.pack(fill="x", padx=14, pady=(0, 6))
        r1.columnconfigure((0, 1), weight=1)
        self._label(r1, "Font").grid(row=0, column=0, sticky="w")
        self._label(r1, "Position").grid(row=0, column=1, sticky="w", padx=(8, 0))
        self.cap_font = ctk.CTkOptionMenu(
            r1, values=["Impact", "Arial Black", "Arial", "Segoe UI Black"])
        self.cap_font.set("Impact")
        self.cap_font.grid(row=1, column=0, sticky="ew", padx=(0, 4))
        self.cap_pos = ctk.CTkOptionMenu(
            r1, values=["Bottom (Reels safe)", "Center (Focus)", "Bottom Low"])
        self.cap_pos.set("Bottom (Reels safe)")
        self.cap_pos.grid(row=1, column=1, sticky="ew", padx=(4, 0))

        r2 = ctk.CTkFrame(c, fg_color="transparent")
        r2.pack(fill="x", padx=14, pady=(0, 6))
        r2.columnconfigure((0, 1), weight=1)
        self._label(r2, "Pacing (words)").grid(row=0, column=0, sticky="w")
        self._label(r2, "Language").grid(row=0, column=1, sticky="w", padx=(8, 0))
        self.cap_pacing = ctk.CTkOptionMenu(
            r2, values=["Punchy (1-2 words)", "Fast (2-3 words)", "Balanced (3-4 words)", "Sentence (5-7)"])
        self.cap_pacing.set("Fast (2-3 words)")
        self.cap_pacing.grid(row=1, column=0, sticky="ew", padx=(0, 4))
        self.cap_lang = ctk.CTkOptionMenu(
            r2, values=list(CAPTION_LANGS.keys()))
        self.cap_lang.grid(row=1, column=1, sticky="ew", padx=(4, 0))

        self._label(c, "Caption size").pack(fill="x", padx=14, pady=(2, 0))
        self.cap_size = ctk.CTkSegmentedButton(c, values=["Small", "Medium", "Large", "Huge"])
        self.cap_size.set("Medium")
        self.cap_size.pack(fill="x", padx=14, pady=(2, 10))

    def _sec_voice(self, parent):
        c = self._card(parent, "5  Voice-over  (optional)")
        self.vo_mode = ctk.CTkOptionMenu(
            c, values=["Off", "AI Narration (TTS)", "Import Audio File"])
        self.vo_mode.pack(fill="x", padx=14, pady=(0, 8))
        vrow = ctk.CTkFrame(c, fg_color="transparent")
        vrow.pack(fill="x", padx=14, pady=(0, 8))
        vrow.columnconfigure((0, 1), weight=1)
        self.tts_model = ctk.CTkEntry(vrow, placeholder_text="TTS model")
        self.tts_model.insert(0, "auto")
        self.tts_model.grid(row=0, column=0, sticky="ew", padx=(0, 4))
        self.tts_voice = ctk.CTkEntry(vrow, placeholder_text="Voice")
        self.tts_voice.insert(0, "alloy")
        self.tts_voice.grid(row=0, column=1, sticky="ew", padx=(4, 0))
        self.vo_btn = ctk.CTkButton(c, text="Choose Voice-Over Audio File...",
                                    fg_color=BTN_GREY, hover_color="#4a5058",
                                    command=self.pick_vo)
        self.vo_btn.pack(fill="x", padx=14, pady=(0, 12))

    # ---------- right-hand panel ----------
    def _build_right(self, r):
        self.go = ctk.CTkButton(r, text="Find & Cut Hype Clips", height=54,
                                font=ctk.CTkFont(size=17, weight="bold"),
                                fg_color="#2563eb", hover_color="#1d4fc4",
                                command=self.start)
        self.go.pack(fill="x", padx=14, pady=(14, 8))
        self.progress = ctk.CTkProgressBar(r, mode="indeterminate", height=6)
        self.progress.pack(fill="x", padx=14)
        self.progress.set(0)
        self.status = ctk.CTkLabel(r, text="Idle", anchor="w", text_color=MUTED)
        self.status.pack(fill="x", padx=16, pady=(6, 4))
        self.console = ctk.CTkTextbox(r, font=ctk.CTkFont(family="Consolas", size=12),
                                      wrap="word")
        self.console.pack(fill="both", expand=True, padx=14, pady=(0, 8))
        self.console.configure(state="disabled")
        brow = ctk.CTkFrame(r, fg_color="transparent")
        brow.pack(fill="x", padx=14, pady=(0, 14))
        brow.columnconfigure((0, 1, 2), weight=1)
        ctk.CTkButton(brow, text="Open Output Folder", fg_color=BTN_GREY,
                      hover_color="#4a5058", command=self.open_out
                      ).grid(row=0, column=0, sticky="ew", padx=(0, 4))
        ctk.CTkButton(brow, text="Open Videos Folder", fg_color=BTN_GREY,
                      hover_color="#4a5058", command=self.open_videos
                      ).grid(row=0, column=1, sticky="ew", padx=4)
        ctk.CTkButton(brow, text="Clear Log", fg_color=BTN_GREY, hover_color="#4a5058",
                      command=self.clear_log).grid(row=0, column=2, sticky="ew", padx=(4, 0))

    # ---------- status / logging ----------
    def log(self, msg):
        msg = str(msg)
        self.logq.put(msg)
        try:
            with open(LOG_FILE, "a", encoding="utf-8") as f:
                f.write("%s  %s\n" % (time.strftime("%H:%M:%S"), msg))
        except OSError:
            pass

    def set_status(self, text, color=None):
        self.logq.put(("status", text, color))

    def _drain(self):
        try:
            while True:
                item = self.logq.get_nowait()
                if isinstance(item, tuple):
                    _, text, color = item
                    self.status.configure(text=text, text_color=color or MUTED)
                    continue
                self.console.configure(state="normal")
                self.console.insert("end", item + "\n")
                self.console.see("end")
                self.console.configure(state="disabled")
        except queue.Empty:
            pass
        self.after(100, self._drain)

    def clear_log(self):
        self.console.configure(state="normal")
        self.console.delete("1.0", "end")
        self.console.configure(state="disabled")

    def _mode_changed(self, value):
        self.mode_info.configure(text=MODE_INFO.get(value, ""))

    def _refresh_tools(self):
        for tool, lab in self.tool_labels.items():
            if shutil.which(tool):
                lab.configure(text="\u25cf " + tool, text_color="#3ddc84")
            else:
                lab.configure(text="\u25cf " + tool + " missing", text_color="#ff6b6b")

    # ---------- actions ----------
    def pick_file(self):
        p = filedialog.askopenfilename(
            title="Select a video",
            filetypes=[("Video files", "*.mp4 *.webm *.mkv"), ("All files", "*.*")])
        if p:
            self.src.delete(0, "end")
            self.src.insert(0, p)
            self.set_status("Selected: " + os.path.basename(p))

    def pick_dl_dir(self):
        d = filedialog.askdirectory(title="Choose download folder")
        if d:
            self.dl_dir.delete(0, "end")
            self.dl_dir.insert(0, d)

    def pick_vo(self):
        p = filedialog.askopenfilename(
            title="Select voice-over audio",
            filetypes=[("Audio files", "*.mp3 *.wav *.m4a *.aac *.ogg *.flac"),
                       ("All files", "*.*")])
        if p:
            self.vo_path = p
            self.vo_btn.configure(text="Voice-over: " + os.path.basename(p))
            self.vo_mode.set("Import Audio File")

    def _open_folder(self, folder):
        os.makedirs(folder, exist_ok=True)
        try:
            if os.name == "nt":
                os.startfile(folder)  # type: ignore[attr-defined]
            elif sys.platform == "darwin":
                subprocess.Popen(["open", folder])
            else:
                subprocess.Popen(["xdg-open", folder])
        except Exception as e:
            self.log("Could not open folder: %s" % e)

    def open_out(self):
        self._open_folder(OUT_DIR)

    def open_videos(self):
        self._open_folder(self.dl_dir.get().strip() or VIDEOS_DIR)

    def _auto_offer(self):
        need = missing_tools()
        if need:
            self._offer_install(need)

    def install_clicked(self):
        need = missing_tools()
        if not need:
            messagebox.showinfo(APP_NAME, "ffmpeg, ffprobe and yt-dlp are already installed.")
            return
        self._offer_install(need)

    def _offer_install(self, need):
        if self.installing or self.busy:
            return
        if os.name != "nt":
            messagebox.showerror(APP_NAME, "Missing: %s\n\nInstall them with your package "
                                 "manager (e.g. brew / apt)." % ", ".join(need))
            return
        if messagebox.askyesno(
                APP_NAME,
                "HypeClipper needs these free tools: %s\n\nDownload and install them "
                "automatically now? (one-time download, roughly 150 MB)" % ", ".join(need)):
            self.installing = True
            self.go.configure(state="disabled")
            self.progress.start()
            threading.Thread(target=self._install_worker, daemon=True).start()

    def _install_worker(self):
        ok = False
        try:
            self.set_status("Installing tools...", "#4da3ff")
            ok = install_tools(self.log, self.set_status)
        except Exception as e:
            self.log("INSTALL ERROR: %r" % (e,))
        finally:
            self.installing = False

            def done():
                self.progress.stop()
                self.progress.set(0)
                self.go.configure(state="normal")
                self._refresh_tools()
            self.after(0, done)
            if ok:
                self.set_status("Tools installed - you're ready to go", "#3ddc84")
            else:
                self.set_status("Some tools are still missing - see the console", "#ff6b6b")

    def check_tools(self):
        self._refresh_tools()

        def work():
            for tool in ("ffmpeg", "ffprobe", "yt-dlp"):
                path = shutil.which(tool)
                if not path:
                    self.log("[tools] %s: NOT FOUND" % tool)
                    continue
                ver = ""
                try:
                    flag = "--version" if tool == "yt-dlp" else "-version"
                    ver = run_capture([tool, flag]).stdout.splitlines()[0]
                except Exception:
                    pass
                self.log("[tools] %s: %s  %s" % (tool, path, ver))
        threading.Thread(target=work, daemon=True).start()

    def update_ytdlp(self):
        def work():
            if not shutil.which("yt-dlp"):
                self.log("yt-dlp not found, nothing to update.")
                return
            self.log("Updating yt-dlp...")
            lines = []
            run_stream(["yt-dlp", "-U"], self.log, collect=lines)
            if any("pip" in l.lower() for l in lines):
                self.log("yt-dlp was installed with pip. Run:  pip install -U yt-dlp")
        threading.Thread(target=work, daemon=True).start()

    def start(self):
        if self.busy:
            return
        src = self.src.get().strip().strip('"')
        if not src:
            messagebox.showwarning(APP_NAME, "Paste a YouTube link or select a local video first.")
            return
        if not os.path.isfile(src) and not is_url(src):
            messagebox.showwarning(APP_NAME, "That is not an existing file or a valid http(s) link.")
            return
        try:
            max_clips = max(1, int(self.max_clips.get()))
            clip_len = max(5, int(self.clip_len.get()))
        except ValueError:
            messagebox.showwarning(APP_NAME, "Max clips and Clip length must be whole numbers.")
            return
        need = missing_tools()
        if not is_url(src):
            need = [t for t in need if t != "yt-dlp"]
        if need:
            self._offer_install(need)
            return
        is_vert = self.aspect.get().startswith("Vertical")
        if is_vert:
            sizes = {"Small": 32, "Medium": 44, "Large": 56, "Huge": 70}
        else:
            sizes = {"Small": 20, "Medium": 26, "Large": 34, "Huge": 44}

        pacing_map = {
            "Punchy (1-2 words)": 2,
            "Fast (2-3 words)": 3,
            "Balanced (3-4 words)": 4,
            "Sentence (5-7)": 6,
        }
        words_per_chunk = pacing_map.get(self.cap_pacing.get(), 3)
        lang, prompt = CAPTION_LANGS[self.cap_lang.get()]
        opts = {"captions": bool(self.captions.get()),
                "cap_style": self.cap_style.get(),
                "cap_font": self.cap_font.get(),
                "cap_pos": self.cap_pos.get(),
                "cap_words": words_per_chunk,
                "cap_upper": bool(self.cap_upper.get()),
                "caption_size": sizes.get(self.cap_size.get(), 44 if is_vert else 26),
                "cap_lang": lang, "cap_prompt": prompt,
                "fade": bool(self.fade.get()),
                "zoom": bool(self.zoom.get()),
                "normalize": bool(self.normalize.get()),
                "vo_mode": self.vo_mode.get(),
                "vo_path": self.vo_path,
                "tts_model": self.tts_model.get().strip() or "auto",
                "tts_voice": self.tts_voice.get().strip() or "alloy",
                "mode": self.mode.get(),
                "cookies": self.cookies.get(),
                "dl_quality": self.dl_quality.get(),
                "dl_dir": self.dl_dir.get().strip() or VIDEOS_DIR,
                "dl_only": bool(self.dl_only.get()),
                "snap": bool(self.snap.get()),
                "framing": self.framing.get(),
                "quality": self.quality.get()}
        set_api_key(self.api_key.get())
        save_settings(api_url=self.api.get().strip() or DEFAULT_API, api_key=API_KEY)
        args = (src, max_clips, clip_len, self.aspect.get().startswith("Vertical"),
                self.api.get().strip() or DEFAULT_API, opts)
        self.busy = True
        self.go.configure(state="disabled", text="Working...")
        self.progress.start()
        self.set_status("Starting...", "#4da3ff")
        threading.Thread(target=self._worker, args=args, daemon=True).start()

    def _finish(self):
        self.busy = False

        def reset():
            self.progress.stop()
            self.progress.set(0)
            self.go.configure(state="normal", text="Find & Cut Hype Clips")
        self.after(0, reset)

    def _worker(self, src, max_clips, clip_len, vertical, api_url, opts):
        log = self.log
        mode = opts.get("mode", MODE_SMART)
        ok = False
        try:
            # 1. input
            if os.path.isfile(src):
                video = src
                log("Using local file: " + video)
            else:
                self.set_status("Downloading video...", "#4da3ff")
                video = download_video(
                    src, log,
                    cookies_browser=opts.get("cookies"),
                    dl_dir=opts.get("dl_dir"),
                    quality=opts.get("dl_quality")
                )
                if not video:
                    return
                log("Downloaded: " + video)
                if opts.get("dl_only"):
                    log("Download only - finished. File saved in: " + os.path.dirname(video))
                    ok = True
                    return
            if opts.get("dl_only"):
                log("That is already a local file, nothing to download.")
                ok = True
                return

            info = None
            info_path = os.path.splitext(video)[0] + ".info.json"
            if os.path.isfile(info_path):
                try:
                    with open(info_path, encoding="utf-8") as f:
                        info = json.load(f)
                except Exception as e:
                    log("Could not read info.json: %s" % e)

            duration = get_duration(video, info)
            log("Duration: %s" % fmt_time(duration))
            log("Mode: " + mode)

            clips = []
            a_peaks, h_peaks = [], heatmap_peaks(info)

            # 2a. highest playtime (YouTube "Most replayed")
            if mode == MODE_REPLAY:
                self.set_status("Reading replay heatmap...", "#4da3ff")
                clips = replayed_clips(info, duration, clip_len, max_clips)
                if clips:
                    log("Picked %d highest-playtime window(s) from the replay heatmap."
                        % len(clips))
                else:
                    log("No YouTube replay heatmap for this video (needs a YouTube link or "
                        "its .info.json, and enough views). Using loudest moments instead.")
                    mode = MODE_LOUD

            # 2b. loudest moments / smart mix
            if not clips:
                self.set_status("Scanning audio for hype...", "#4da3ff")
                a_peaks = audio_peaks(video, duration, log)
                log("Heatmap peaks: %d" % len(h_peaks) if h_peaks
                    else "No YouTube heatmap available.")

            if not clips and mode == MODE_SMART:
                transcript = load_transcript(video)
                log("Transcript loaded (%d chars)." % len(transcript) if transcript
                    else "No subtitles found.")
                self.set_status("Asking the AI for the best moments...", "#4da3ff")
                try:
                    base = api_base(api_url)
                    model = pick_model(base, log)
                    raw = ask_llm(base, model, duration, clip_len, max_clips,
                                  a_peaks, h_peaks, transcript, log)
                    clips = clean_clips(raw, duration, clip_len, max_clips)
                except (urllib.error.URLError, OSError, ValueError, KeyError,
                        RuntimeError, json.JSONDecodeError) as e:
                    log("LLM step failed: %s" % e)

            if not clips:
                log("Selecting loudest / hottest moments directly.")
                clips = fallback_clips(a_peaks, h_peaks, duration, clip_len, max_clips)
            if not clips:
                log("No clips could be determined.")
                return
            if opts.get("snap"):
                self.set_status("Finding clean cut points...", "#4da3ff")
                mids = detect_silences(video, log)
                clips = snap_clips(clips, mids, duration, clip_len) or clips
            log("Selected clips:\n" + json.dumps(clips, indent=2))

            # 3. cut
            self.set_status("Cutting clips...", "#4da3ff")
            cut_clips(video, clips, vertical, log, opts, api_base(api_url))
            log("Done! Clips are in: " + OUT_DIR)
            ok = True
        except Exception as e:
            log("UNEXPECTED ERROR: %r" % e)
        finally:
            if ok:
                self.set_status("Done - clips are in output_clips", "#3ddc84")
            else:
                self.set_status("Stopped - see the console for details", "#ff6b6b")
            self._finish()


if __name__ == "__main__":
    try:
        App().mainloop()
    except Exception:
        import traceback
        tb = traceback.format_exc()
        try:
            with open(os.path.join(BASE, "hypeclipper_crash.log"), "w", encoding="utf-8") as f:
                f.write(tb)
        except OSError:
            pass
        try:
            import tkinter
            root = tkinter.Tk()
            root.withdraw()
            messagebox.showerror(APP_NAME, "HypeClipper crashed:\n\n" + tb[-1500:])
        except Exception:
            pass
