        self.clip_len.grid(row=1, column=1, sticky="ew", padx=(4, 0))

        arow = ctk.CTkFrame(c, fg_color="transparent")
        arow.pack(fill="x", padx=14, pady=(0, 12))
        arow.columnconfigure(0, weight=3)
        arow.columnconfigure(1, weight=2)
        self._label(arow, "API URL (OpenAI-compatible)").grid(row=0, column=0, sticky="w")
        self._label(arow, "API Key").grid(row=0, column=1, sticky="w", padx=(8, 0))
        self.api = ctk.CTkEntry(arow)
        self.api.insert(0, load_settings().get("api_url") or DEFAULT_API)
        self.api.grid(row=1, column=0, sticky="ew", padx=(0, 4))
        self.api_key = ctk.CTkEntry(arow, show="*", placeholder_text="FREELLMAPI_KEY")
        if API_KEY:
            self.api_key.insert(0, API_KEY)
        self.api_key.grid(row=1, column=1, sticky="ew", padx=(4, 0))

    def _sec_edit(self, parent):
        c = self._card(parent, "3  Editing  (all optional)")
        self.snap = ctk.CTkSwitch(c, text="Snap cuts to natural pauses")
        self.snap.select()
        self.snap.pack(anchor="w", padx=14, pady=3)
        self.fade = ctk.CTkSwitch(c, text="Fade in / out")
        self.fade.pack(anchor="w", padx=14, pady=3)
        self.zoom = ctk.CTkSwitch(c, text="Punch-in zoom (1.15x)")
        self.zoom.pack(anchor="w", padx=14, pady=3)
        self.normalize = ctk.CTkSwitch(c, text="Normalize loudness")
        self.normalize.pack(anchor="w", padx=14, pady=3)
        self._label(c, "Vertical framing (9:16 only)").pack(fill="x", padx=14, pady=(8, 0))
        self.framing = ctk.CTkOptionMenu(
            c, values=["Blurred background fit", "Smart crop (follow action)", "Center crop"])
        self.framing.pack(fill="x", padx=14, pady=(2, 8))
        self._label(c, "Video quality").pack(fill="x", padx=14)
        self.quality = ctk.CTkSegmentedButton(c, values=["Fast", "Balanced", "High"])
        self.quality.set("Balanced")
        self.quality.pack(fill="x", padx=14, pady=(2, 12))

    def _sec_captions(self, parent):
        c = self._card(parent, "4  Captions  (AI Viral Styles)")
        top_row = ctk.CTkFrame(c, fg_color="transparent")
        top_row.pack(fill="x", padx=14, pady=(0, 4))
