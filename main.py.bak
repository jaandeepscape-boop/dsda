        self.aspect.set("Original 16:9")
        self.aspect.pack(fill="x", padx=14, pady=(2, 8))

        nrow = ctk.CTkFrame(c, fg_color="transparent")
        nrow.pack(fill="x", padx=14, pady=(0, 8))
        nrow.columnconfigure((0, 1), weight=1)
        self._label(nrow, "Max clips").grid(row=0, column=0, sticky="w")
        self._label(nrow, "Clip length (sec)").grid(row=0, column=1, sticky="w", padx=(8, 0))
        self.max_clips = ctk.CTkEntry(nrow)
        self.max_clips.insert(0, "3")
        self.max_clips.grid(row=1, column=0, sticky="ew", padx=(0, 4))
        self.clip_len = ctk.CTkEntry(nrow)
